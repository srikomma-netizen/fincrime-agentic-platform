# Copy to `.env` and fill in as needed. Everything has safe offline defaults.

# ---- LLM provider selection ----
# One of: mock (default, offline & deterministic), anthropic, openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# ---- RAG backend ----
# auto = use FAISS + sentence-transformers if installed, else TF-IDF fallback
RAG_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Security ----
# Toggle PHI/PII masking before any payload reaches the LLM layer
ENABLE_PII_MASKING=true

# ---- Risk thresholds (routing) ----
RISK_LOW_MAX=0.35
RISK_HIGH_MIN=0.70

# ---- Artifacts ----
MODEL_DIR=artifacts
VECTOR_DIR=artifacts/vector_index
